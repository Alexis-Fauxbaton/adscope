{
  "manifest_version": 3,
  "name": "adscope",
  "version": "0.1.0",
  "description": "Affiche l'ancienneté réelle des annonces automobiles et signale celles qui ont été réactualisées.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/sw.js"
  },
  "action": {
    "default_title": "adscope",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.leboncoin.fr/*"],
      "js": [
        "src/sites/leboncoin.js",
        "src/format.js",
        "src/view.js",
        "src/sync.js",
        "src/listing.js",
        "src/detail.js"
      ],
      "css": ["src/ui.css"],
      "run_at": "document_idle"
    }
  ]
}
