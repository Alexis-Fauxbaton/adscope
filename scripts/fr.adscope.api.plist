<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>fr.adscope.api</string>

  <key>ProgramArguments</key>
  <array>
    <string>__API__/.venv/bin/uvicorn</string>
    <string>adscope_api.main:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8000</string>
    <string>--log-level</string><string>warning</string>
  </array>

  <key>WorkingDirectory</key><string>__API__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key><string>postgresql+psycopg://localhost/adscope</string>
    <!-- Mode local : /v1/auth/login rend le lien de connexion dans sa réponse.
         Tant qu'aucun fournisseur d'envoi n'est branché, c'est le seul moyen de
         se connecter. À retirer au go-live : qui peut appeler l'API entre dans
         n'importe quel compte. Le service l'annonce au démarrage dans
         ~/Library/Logs/adscope-api.log. -->
    <key>ADSCOPE_DEV_LOGIN</key><string>1</string>
    <!-- L'hôte du lien de vérification envoyé par email, jamais celui de la
         requête (`Host` peut être forgé). C'est l'hôte que l'extension utilise
         par défaut (`extension/src/sw.js`, DEFAULTS.apiBase) — un seul hôte
         partout, sans quoi le cookie de session posé par la vérification
         n'existe pas pour l'autre. -->
    <key>ADSCOPE_PUBLIC_URL</key><string>http://localhost:8000</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <key>StandardOutPath</key><string>__HOME__/Library/Logs/adscope-api.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/adscope-api.log</string>
</dict>
</plist>
